<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<PackageId>Comex.GeneradorRelatorio</PackageId>
	<Title>Comex Gerador de Relatórios</Title>
	<Version>1.0.0</Version>
	<Description>Biblioteca para geração de relatórios CSV.</Description>
	<Authors>KRN</Authors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="34.0.0" />
  </ItemGroup>

</Project>
